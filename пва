#include <iostream>
using namespace std;
template<typename T, typename T1>
void reverse(T arr[], T1 size)
{
	for (int i = 0; i < size/2; i++)
	{
		swap(arr[i],arr[size-1-i]);
	}
}
void print(int arr[], int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << arr[i];
	}
}
int main() {
	const int N = 4;
	int arr[N] = { 4,3,2,1 };
	reverse(arr, N);
	print(arr, N);
}
