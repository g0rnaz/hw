#include <iostream>
using namespace std;
int main() {
	int const unsigned N = 5;
	int arr[N];
	int save;
	srand(time(0));
	for (int i = 0; i < N; i++)
	{
		arr[i] = rand() % 100;
	}
	for (int i = 1; i < N; i++)
	{
		if (arr[i] > arr[i - 1])
		{
			save = arr[i];
			arr[i] = arr[i - 1];
			arr[i - 1] = save;
			if (i != 1)
			{
				i -= 2;
			}
		}
	}
	for (int i = 0; i < N; i++)
	{
		if (i == 0 || i == N - 1)
		{
			arr[i] = arr[N / 2];
		}
		cout << arr[i] << " ";
	}
	cout <<endl<< arr[N - 1] << " " << arr[0];
}
