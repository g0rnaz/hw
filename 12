#include <iostream>
using namespace std;
int max(int a, int b, int c) {
	int max = a;
	if (max < b)
	{
		max = b;
	}
	else {
		return max;
	}
	if (max < c)
	{
		max = c;
	}
	else {
		return max;
	}
	if (max < a)
	{
		max = a;
	}
	else {
		return max;
	}
}
int main(){
	cout << max(5, 4, 3);
}

#include <iostream>
using namespace std;
int firstNumber(int a) {
	int amount = 1, number, saver = 0;
	if (a > 0)
	{
		number = 10;
	}
	else
	{
		number = -10;
	}
	for (int i = 0; i < amount; i++)
	{
		saver = a % number;
		if (a == saver)
		{
			saver = saver / (number / 10);
			return saver;
		}
		a -= saver;
		amount++;
		number *= 10;
	}
}
int main() {
	cout << firstNumber(-10);
}
