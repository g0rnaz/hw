#include <iostream>
using namespace std;
int* numberr(int* random, int j, const int TOTAL_NUMBERS=10) {
	for (int l = TOTAL_NUMBERS; l >= 0; l--)
	{
		if (*random < j)
		{
			j -= l;
		}
		else if (*random >= j)
		{
			*random = TOTAL_NUMBERS - l - 1;
			break;
		}
	}
	return random;
}
void number_generator(int iften, int* random, double number, double* best, const int SUMM_FROM_1_TO_10=55, const int TOTAL_NUMBERS=10) {
	for (int k = 0; k < iften; k++)
	{
		*random = rand() % SUMM_FROM_1_TO_10;
		int j = SUMM_FROM_1_TO_10;
		numberr(random, j);
		number += *random * pow(10, k);
		if (rand() % TOTAL_NUMBERS == 9)
		{
			iften++;
		}
		else {
			if (number > *best)
			{
				*best = number;
			}
			cout << number << " ";
		}
	}
