#include <iostream>
using namespace std;
void sorting(int* arr, int size,void (*arrFunc[])(int*, int), int choice) {
	arrFunc[choice](arr, size);
}
void filler(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		arr[i] = rand() % 10;
	}
}
void bubble(int* arr, int size) {
	for (int i = 0; i < size-1; i++)
	{
		for (int j = 0; j < size-1; j++)
		{
			if (arr[j] > arr[j + 1])
			{
				swap(arr[j], arr[j + 1]);
			}
		}
	}
}
void gnome(int* arr, int size)
{
	int save;
	for (int i = 1; i < size; i++)
	{
		if (arr[i] < arr[i - 1])
		{
			swap(arr[i - 1], arr[i]);
			if (i != 1)
			{
				i -= 2;
			}
		}
	}
}
void choose(int* arr, int size) {
	int min_i=0, min=0;

	for (int i = 0; i < size; i++)
	{
		min = i;
		for (int j = min_i; j < size; j++)
		{
			if (arr[min] > arr[j])
			{
				min = j;
			}
		}
		swap(arr[min_i], arr[min]);
		min_i++;
	}
}
void printer(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << arr[i] << " ";
	}
	cout << endl;
}

int main() {

	srand(time(0));
	int choice, n;
	cout << "0 is choose 1 is gnome 2 is bubble";
	cin >> n >> choice;
	int* arr = new int[n];
	const int N = 3;
	void (*arrFunc[N])(int*, int) = { choose, gnome, bubble };
	
	filler(arr, n);
	sorting(arr, n, arrFunc, choice);
	printer(arr, n);
	delete[] arr;
}
