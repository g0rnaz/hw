#include <iostream>
using namespace std;
void filler(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		arr[i] = rand() % 10;
	}
}
void mini(int &min, int* arr, int size)
{
	min = arr[0];
	for (int i = 0; i < size; i++)
	{
		if (min > arr[i])
		{
			min = arr[i];
		}
	}
}
int* onetime(int min, int* arr, int size, int &sizee)
{	
	int counter = 0, amount = 0, minsaver = min, whilecounter = 0;
	while (whilecounter!=size)
	{
		counter = 0;
		for (int i = 0; i < size; i++)
		{
			if (min == arr[i])
			{
				counter++;
			}
		}
		if (counter == 1)
		{

			amount++;
		}
		min++;
		whilecounter++;
	}
	whilecounter = 0;
	sizee = amount;
	int* newarr = new int[amount];
	amount = 0;
	min = minsaver;
	while (whilecounter != size)
	{
		counter = 0;
		for (int i = 0; i < size; i++)
		{
			if (min == arr[i])
			{
				counter++;
			}
		}
		if (counter == 1)
		{
			newarr[amount] = min;
			amount++;
		}
		min++;
		whilecounter++;
	}
	return newarr;
}
int* morethan2(int min, int* arr, int size, int& size2)
{

	int counter = 0, amount = 0, minsaver = min, whilecounter = 0;
	while (whilecounter != size)
	{
		counter = 0;
		for (int i = 0; i < size; i++)
		{
			if (min == arr[i])
			{
				counter++;
			}
		}
		if (counter > 2)
		{

			amount++;
		}
		min++;
		whilecounter++;
	}
	whilecounter = 0;
	int* arrchecker = new int[amount];
	amount = 0;
	min = minsaver;
	while (whilecounter != size)
	{
		counter = 0;
		for (int i = 0; i < size; i++)
		{
			if (min == arr[i])
			{
				counter++;
			}
		}
		if (counter > 2)
		{
			arrchecker[amount] = min;
			amount++;
		}
		min++;
		whilecounter++;
	}
	counter = 0;
	for (int i = 0; i < size; i++)
	{
		for (int k = 0; k < amount; k++)
		{
			if (arr[i] == arrchecker[k])
			{
				counter++;
			}
		}
	}
	int* newarr = new int[counter];
	int j=0;
	for (int i = 0; i < size; i++)
	{
		for (int k = 0; k < amount; k++)
		{
			if (arr[i] == arrchecker[k])
			{
				newarr[j] = arr[i];
				j++;
			}
		}
	}
	size2 = counter;
	delete[] arrchecker;
	return newarr;
}
void printer(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << arr[i] << " ";
	}
	cout << endl;
}

int main() {
	int min, size1, size2;
	int N;
	cin >> N;
	int* arr = new int[N];
	srand(time(0));
	filler(arr, N);
	mini(min, arr, N);
	int* result1 = onetime(min, arr, N, size1);
	int* result2 = morethan2(min, arr, N, size2);
	printer(result1, size1);
	printer(result2, size2);
	delete[] arr;
	delete[] result1;
	delete[] result2;
}
