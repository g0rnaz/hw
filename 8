#include <iostream>
using namespace std;
int main() {
	int const unsigned N = 30;
	int arr[N], arow[N];
	int summ, row = 0, highestrow=0;
	for (int i = 0; i < N; i++)
	{
		cin >> arr[i];
	}
	for (int i = 0; i < N; i++)
	{
		if (i == 0)
		{
			summ = arr[i];
		}
		else
		{
			summ += arr[i];
		}
	}
	for (int i = 0; i < N; i++)
	{
		if (arr[i] < summ/N)
		{
			row++;
			if (highestrow < row)
			{
				highestrow = row;
			}
		}
		else
		{
			row = 0;
		}
	}
	for (int i = 0; i < N; i++)
	{
		cout << arr[i] << " ";
	}

	cout <<endl << summ / N << endl << highestrow;

}
