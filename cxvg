#include <iostream>
using namespace std;
int converter(char* word) {
	int converted_word=0;
	int multiplier = 0;
	for (int i = 0; i < strlen(word); i++)
	{
		if (word[i] > 0)
		{
			converted_word += word[i];
			if (word[i+1] < 10)
			{
				multiplier=10;
			}
			else if (word[i+1] < 100)
			{
				multiplier+=100;
			}
			else {
				multiplier += 1000;
			}
			if (word[i+1]>=0)
			{
				converted_word *= multiplier;
			}
			else {
				cout << "failed";
				return 0;
			}
			multiplier = 0;
		}
	}
	converted_word /= 10;
	return converted_word;
}
int main() {
	const int N = 90;
	char word[N] = "bobя";
	int result = converter(word);
	cout << result;
}
