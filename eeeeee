void clearNames(Student* students, uint size)

{

	for (int i = 0; i < size; i++)

	{

		delete[] students[i].name;

	}

}

void clear(Student* students, uint size)

{

	clearNames(students, size);

	delete[] students;

}

void sortByName(Student* students, uint size)

{

	for (uint i = 0; i < size - 1; i++)

	{

		for (uint j = 0; j < size - 1; j++)

		{

			if (strcmp(students[j].name, students[j + 1].name)>0)

			{

				swap(students[j], students[j + 1]);

			}

		}

	}

	for (uint i = 0; i < size; i++)

	{

		showStudent(students[i]);

	}

}

void sortById(Student* students, uint size)

{

	for (uint i = 0; i < size - 1; i++)

	{

		for (uint j = 0; j < size - 1; j++)

		{

			if (students[j].id > students[j + 1].id)

			{

				swap(students[j], students[j + 1]);

			}

		}

	}

	for (uint i = 0; i < size; i++)

	{

		showStudent(students[i]);

	}

}

void sortByAverage(Student* students, uint size)

{

	for (uint i = 0; i < size - 1; i++)

	{

		for (uint j = 0; j < size - 1; j++)

		{

			if (students[j].average > students[j + 1].average)

			{

				swap(students[j], students[j + 1]);

			}

		}

	}

	for (uint i = 0; i < size; i++)

	{

		showStudent(students[i]);

	}

}

void sortByBday(Student* students, uint size)

{

	for (uint i = 0; i < size - 1; i++)

	{

		for (uint j = 0; j < size - 1; j++)

		{

			if (students[j].birthdayDate.year > students[j + 1].birthdayDate.year)

			{

				swap(students[j], students[j + 1]);

			}

			else if (students[j].birthdayDate.month > students[j + 1].birthdayDate.month)

			{

				swap(students[j], students[j + 1]);

			}

			else if (students[j].birthdayDate.day > students[j + 1].birthdayDate.day)

			{

				swap(students[j], students[j + 1]);

			}

		}

	}

	for (uint i = 0; i < size; i++)

	{

		showStudent(students[i]);

	}

}

Student* deletestudent(Student* students, unsigned int& size, int id)

{

	bool checker = 0;

	for (int i = 0; i < size; i++)

	{

		if (students[i].id == id)

		{

			checker = 1;

		}

	}

	if (checker == 0)

	{

		cout << "id is incorrect" << endl;

		return students;

	}

	Student* students2 = new Student[size - 1];

	int j = 0;

	for (int i = 0; i < size; i++)

	{
 
		if (id != students[i].id)

		{

			students2[j].name = new char[strlen(students[i].name) + 1];

			strcpy_s(students2[j].name, strlen(students[i].name) + 1, students[i].name);

			students2[j].id = students[i].id;

			students2[j].average = students[i].average;

			students2[j].birthdayDate.year = students[i].birthdayDate.year;

			students2[j].birthdayDate.month = students[i].birthdayDate.month;

			students2[j].birthdayDate.day = students[i].birthdayDate.day;

			j++;

		}

	}

	clear(students, size);

	size--;

	return students2;

}

Student* addstudent(Student* students, unsigned int& size)

{

	size++;

	Student* students2 = new Student[size];

	for (int i = 0; i < size; i++)

	{

		if (i == size - 1)

		{

			students2[i] = createStudent();

		}

		else {

			students2[i].name = new char[strlen(students[i].name) + 1];

			strcpy_s(students2[i].name, strlen(students[i].name) + 1, students[i].name);

			students2[i].id = students[i].id;

			students2[i].average = students[i].average;

			students2[i].birthdayDate.year = students[i].birthdayDate.year;

			students2[i].birthdayDate.month = students[i].birthdayDate.month;

			students2[i].birthdayDate.day = students[i].birthdayDate.day;

		}

	}

	clear(students, size - 1);

	return students2;

}
 
