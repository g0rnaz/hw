#include <iostream>
using namespace std;
void filler(int* arr, int size) {
	for (int i = 0; i < size; i++)
	{
		arr[i] = rand() % (10+10)-10;
	}
}
void printer(int* arr, int size) {
	for (int i = 0; i < size; i++)
	{
		cout << arr[i] << " ";
	}
	cout << endl;
}
int* merger(int* arr, int nsize, int* ar, int msize, int& plusses) {
	plusses = 0;
	for (int i = 0; i < nsize; i++)
	{
		if (arr[i] >= 0)
		{
			plusses++;
		}
	}
	for (int i = 0; i < msize; i++)
	{
		if (ar[i] >= 0)
		{
			plusses++;
		}
	}
	int* arrnew = new int[plusses];
	int j = 0;
	for (int i = 0; i < nsize; i++)
	{
		if (arr[i] >= 0)
		{
			arrnew[j] = arr[i];
			j++;
		}
	}
	for (int i = 0; i < msize; i++)
	{
		if (ar[i] >= 0)
		{
			arrnew[j] = ar[i];
			j++;
		}
	}

	return arrnew;
}
int main() {
	srand(time(0));
	int n, m, size;
	cin >> n >> m;
	int* arr = new int[n];
	int* ar = new int[m];
	filler(arr, n);
	filler(ar, m);
	printer(arr, n);
	printer(ar, m);
	int* result = merger(arr, n, ar, m, size);
	printer(result, size);
	delete[] arr;
	delete[] ar;
	delete[] result;
}
