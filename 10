#include <iostream>
using namespace std;
int main() {
	const int unsigned N = 5;
	int save,key;
	int arr[N]{ 1,3,5,2,4 };
	for (int i = 0; i < N-1; i++)
	{
		key = i + 1;
		save = arr[i + 1];
		for (int j = i + 1; j > 0; j--)
		{
			if (save < arr[j - 1])
			{
				arr[j] = arr[j - 1];
				key = j - 1;
			}
			else
			{
				break;
			}
		}
		arr[key] = save;
	}
	for (int i = 0; i < N; i++)
	{
		cout << arr[i] << " ";
	}

}
