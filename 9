#include <iostream>
using namespace std;
int main() {
	int const unsigned N = 24, NUM=3;
	int arr[N],arrmax[NUM],arrmin[NUM], max, min;
	for (int i = 0; i < N; i++)
	{
		cin >> arr[i];
	}
	for (int i = 0; i < N-2; i++)
	{
		if (i == 0)
		{
			max = arr[i] + arr[i + 1] + arr[i + 2];
			min = arr[i] + arr[i + 1] + arr[i + 2];
			for (int j = i; j < i+3; j++)
			{
				arrmin[j] = arr[j];
				arrmax[j] = arr[j];
			}
		}
		if (max < (arr[i] + arr[i + 1] + arr[i + 2]))
		{
			max = arr[i] + arr[i + 1] + arr[i + 2];
			for (int j = 0; j < NUM; j++)
			{
				arrmax[j] = arr[j+i];
			}
		}
		if (min > (arr[i] + arr[i + 1] + arr[i + 2]))
		{
			min = arr[i] + arr[i + 1] + arr[i + 2];
			for (int j = 0; j < NUM; j++)
			{
				arrmin[j] = arr[j+i];
			}
		}
	}
	for (int i = 0; i < N; i++)
	{
		cout << arr[i];
	}
	cout << endl;
	for (int i = 0; i < NUM; i++)
	{
		cout << arrmax[i];
	}
	cout << endl;
	for (int i = 0; i < NUM; i++)
	{
		cout << arrmin[i];
	}

}
