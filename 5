#include <iostream>
using namespace std;
int main()
{
	int const unsigned N = 6;
	int arr[N];
	int summ=0,avg,max,min;
	for (int i = 0; i < N; i++)
	{
		cin >> arr[i];
	}
	for (int i = 0; i < N; i++)
	{
		cout << arr[i] << " ";
	}
	cout << endl;
	for (int i = 0; i < N; i++)
	{
		summ += arr[i];
	}
	for (int i = 0; i < N; i++)
	{
		avg = summ/N;
		if (i == 0)
		{
			max = arr[i];
			min = arr[i];
		}
		if (max < arr[i])
		{
			max = arr[i];
		}
		else if (min > arr[i])
		{
			min = arr[i];
		}
	}
	for (int i = 0; i < N; i++)
	{
		if (max == arr[i])
		{
			cout << "max:" << i+1 << endl;
		}
		else if (min == arr[i])
		{
			cout << "min:" << i+1 << endl;
		}
	}
	cout << avg;
}
